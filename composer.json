{
  "name": "websk/php-utils",
  "description": "PHP utils",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "WebSK\\": "src/WebSK/"
    }
  },
  "scripts": {
    "lint": "find src -name '*.php' -print0 | xargs -0 -n1 php -l",
    "test": "phpunit"
  },
  "archive": {
    "exclude": [
      "/.idea",
      "/.phpunit.cache",
      "/vendor"
    ]
  }
}
